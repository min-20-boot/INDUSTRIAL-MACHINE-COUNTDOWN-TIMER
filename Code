#include "stm32f4xx.h"

// --- Global Variables ---
int count = 0;         
int is_running = 0; 

void GPIO_Init(void);
void Display_Value(int val);
void Delay_ms(int ms);

int main(void) {
    GPIO_Init();
    
    while (1) {
        Display_Value(count); // Update 7-segment displays

        if (!is_running) {
            // --- Input: SET TIME (SW3 on PB0) ---
            // Check if PB0 is LOW (pressed)
            if (!(GPIOB->IDR & (1 << 0))) { 
                count++;
                if (count > 99) count = 0; 
                
                // Visual feedback: blink display briefly
                GPIOC->ODR = 0; 
                Delay_ms(150); 
            }
            // --- Input: START (SW1 on PA2) ---
            if (!(GPIOA->IDR & (1 << 2)) && count > 0) { 
                is_running = 1;
            }
        }

        // --- Input: RESET (SW2 on PA3) ---
        if (!(GPIOA->IDR & (1 << 3))) {
            is_running = 0;
            count = 0;
        }

        // --- Countdown Logic ---
        if (is_running) {
            GPIOB->ODR |= (1 << 12); // Blue LED ON
            Delay_ms(1000);          
            
            if (count > 0) {
                count--;
            } else {
                is_running = 0;      
            }
        } else {
            GPIOB->ODR &= ~(1 << 12); // Blue LED OFF
        }
    }
}
void GPIO_Init(void) {
    // Enable Clocks: Port A, B, and C
    RCC->AHB1ENR |= (RCC_AHB1ENR_GPIOAEN | RCC_AHB1ENR_GPIOBEN | RCC_AHB1ENR_GPIOCEN);

    // PA2 & PA3 (SW1, SW2) as Inputs with Pull-up
    GPIOA->MODER &= ~(GPIO_MODER_MODER2 | GPIO_MODER_MODER3);
    GPIOA->PUPDR |= (GPIO_PUPDR_PUPDR2_0 | GPIO_PUPDR_PUPDR3_0);

    // PB0 (SW3) as Input with Pull-up
    GPIOB->MODER &= ~(GPIO_MODER_MODER0);
    GPIOB->PUPDR |= (GPIO_PUPDR_PUPDR0_0);

    // PC0-PC15 as Outputs for Displays
    GPIOC->MODER = 0x55555555; 

    // PB12 as Output for LED
    GPIOB->MODER &= ~(GPIO_MODER_MODER12);
    GPIOB->MODER |= (GPIO_MODER_MODER12_0);
}
